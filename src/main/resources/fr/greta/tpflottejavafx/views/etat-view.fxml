<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.TextFlow?>

<AnchorPane prefHeight="377.0" prefWidth="734.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.greta.tpflottejavafx.controllers.EtatController">
    <Label alignment="CENTER" prefHeight="31.0" prefWidth="734.0" style="-fx-background-color: blue;"
           text="===============   ÉTATS ET EXPORTS   ===============" textFill="WHITE"/>
    <HBox alignment="CENTER_LEFT" layoutX="24.0" layoutY="61.0" prefHeight="26.0" prefWidth="498.0" spacing="20.0">
        <Label text="Génération d'un PDF de l'état de la flotte et envoi par courriel"/>
        <Button fx:id="envoiMail" mnemonicParsing="false" onAction="#onEnvoiMailClick" text="Envoi courriel"/>
    </HBox>
    <Button fx:id="exportSalarie" layoutX="24.0" layoutY="158.0" mnemonicParsing="false"
            onAction="#onExportSalarieClick" text="Export des salariés"/>
    <TextFlow fx:id="data" layoutX="213.0" layoutY="158.0" prefHeight="199.0" prefWidth="497.0"
              style="-fx-border-color: blue;"/>
    <Label layoutX="213.0" layoutY="129.0" text="Lecture du fichier des données exportées :"/>
    <Button fx:id="menuPrincipal" layoutX="614.0" layoutY="49.0" mnemonicParsing="false" onAction="#onMenuClick"
            style="-fx-background-color: blue;" text="Menu principal" textFill="WHITE"/>
    <Button fx:id="exportResa" layoutX="24.0" layoutY="198.0" mnemonicParsing="false" onAction="#onExportResaClick"
            text="Export des réservations"/>
    <Label layoutX="26.0" layoutY="129.0" text="Export chiffré des données:"/>
</AnchorPane>
