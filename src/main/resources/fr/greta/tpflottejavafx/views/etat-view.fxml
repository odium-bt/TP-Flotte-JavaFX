<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.TextFlow?>

<AnchorPane prefHeight="400.0" prefWidth="631.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.greta.tpflottejavafx.controllers.EtatController">
    <Label alignment="CENTER" prefHeight="31.0" prefWidth="734.0" style="-fx-background-color: blue;" text="===============   ÉTATS ET EXPORTS   ===============" textFill="WHITE" />
   <HBox layoutX="24.0" layoutY="75.0" prefHeight="26.0" prefWidth="368.0">
      <children>
         <TextField fx:id="courriel" prefHeight="26.0" prefWidth="237.0" />
         <Button fx:id="envoiMail" mnemonicParsing="false" onAction="#onEnvoiMailClick" text="Envoi courriel" />
      </children>
   </HBox>
   <Label layoutX="24.0" layoutY="50.0" text="Génération d'un PDF de l'état de la flotte et envoi par courriel" />
   <Button fx:id="exportPdf" layoutX="24.0" layoutY="133.0" mnemonicParsing="false" onAction="#onExportClick" text="Export des salariés et réservations" />
   <TextFlow fx:id="message" layoutX="24.0" layoutY="200.0" prefHeight="182.0" prefWidth="686.0" style="-fx-border-color: blue;" />
   <Label layoutX="24.0" layoutY="174.0" text="Lecture du fichier des données exportées :" />
   <Button fx:id="menuPrincipal" layoutX="614.0" layoutY="46.0" mnemonicParsing="false" onAction="#onMenuClick" style="-fx-background-color: blue;" text="Menu principal" textFill="WHITE" />
</AnchorPane>
