<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="683.0"
            prefWidth="548.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.greta.tpflottejavafx.controllers.FlotteController">
    <children>
        <Label alignment="CENTER" prefHeight="31.0" prefWidth="548.0" style="-fx-background-color: blue;" text="===============   GESTION DE LA FLOTTE   ===============" textFill="WHITE" />
        <HBox alignment="CENTER_LEFT" layoutX="316.0" layoutY="46.0" prefHeight="46.0" prefWidth="205.0" spacing="20.0">
         <children>
            <Label prefHeight="18.0" prefWidth="105.0" text="Ajouter un véhicule" />
            <Button mnemonicParsing="false" style="-fx-background-color: green;" text="Ajouter" textFill="WHITE" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding></HBox>
      <TableView layoutX="31.0" layoutY="260.0" prefHeight="382.0" prefWidth="486.0">
        <columns>
          <TableColumn prefWidth="75.0" text="Immat." />
            <TableColumn prefWidth="75.0" text="Marque" />
            <TableColumn prefWidth="75.0" text="Modèle" />
            <TableColumn prefWidth="75.0" text="Mise circ." />
            <TableColumn prefWidth="75.0" text="km" />
            <TableColumn prefWidth="75.0" text="État" />
        </columns>
      </TableView>
      <VBox layoutX="30.0" layoutY="174.0" prefHeight="70.0" prefWidth="306.0">
         <children>
            <Label text="Rechercher un véhicule par son immatriculation" />
            <HBox alignment="CENTER_LEFT" prefHeight="34.0" prefWidth="398.0" spacing="20.0">
               <children>
                  <TextField prefHeight="26.0" prefWidth="171.0" />
                  <Button mnemonicParsing="false" prefHeight="26.0" prefWidth="96.0" text="Rechercher" />
               </children>
               <padding>
                  <Insets bottom="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
      <VBox layoutX="31.0" layoutY="104.0" prefHeight="70.0" prefWidth="305.0">
         <children>
            <Label text="Retirer un véhicule à partir de son immatriculation" />
            <HBox alignment="CENTER_LEFT" prefHeight="46.0" prefWidth="315.0" spacing="20.0">
               <children>
                  <TextField prefHeight="26.0" prefWidth="171.0" />
                  <Button mnemonicParsing="false" prefHeight="26.0" prefWidth="96.0" text="Retirer" />
               </children>
               <padding>
                  <Insets bottom="10.0" right="10.0" top="10.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
      <VBox layoutX="358.0" layoutY="104.0" prefHeight="57.0" prefWidth="164.0">
         <children>
            <Label text="Trier" />
            <ChoiceBox prefWidth="150.0" />
         </children>
      </VBox>
    </children>
</AnchorPane>
